# Quiz Club KLS GIT - Environment Variables
# Local development: copy to .env.local. Production: set in Vercel -> Project Settings -> Environment Variables.
# NEVER commit real values. None of these (except the URL) may have a NEXT_PUBLIC_ prefix.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE key (Project Settings -> API). Server-only, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random string, at least 32 characters, used to sign login cookies.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Quizmaster login (checked on the server only)
QM_USERNAME=choose-a-username
QM_PASSWORD=choose-a-long-password
